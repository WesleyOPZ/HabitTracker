<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HabitTracker.Desktop.ViewModels"
             xmlns:views="using:HabitTracker.Desktop.Views"
             xmlns:converters="using:HabitTracker.Desktop.Converters"
             x:Class="HabitTracker.Desktop.Views.HabitsView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <!-- Conversores usados apenas no shell da página (filtro de categoria e contagem de colunas) -->
        <converters:CategoryDisplayConverter x:Key="CategoryDisplayConverter" />
        <converters:CountAtMostConverter x:Key="CountAtMostConverter" />
        <converters:CountAboveConverter x:Key="CountAboveConverter" />

        <!-- Template de item: cada KanbanColumnViewModel vira um KanbanColumnView.
             O DataContext do UserControl é setado automaticamente pelo Avalonia
             para o item da coleção, então KanbanColumnView já nasce com o
             KanbanColumnViewModel correto como DataContext. -->
        <DataTemplate x:Key="KanbanColumnItemTemplate" x:DataType="vm:KanbanColumnViewModel">
            <views:KanbanColumnView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- Topo: Filtro de Categoria e Menu de Ações -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="6,0,6,16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="📁 Category:"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ColorTextSecondary}"
                           FontSize="13" />
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Width="150"
                          Background="{StaticResource ColorSurface}"
                          Foreground="{StaticResource ColorTextPrimary}"
                          BorderBrush="{StaticResource ColorBorder}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource CategoryDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="↕️ Sort:"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ColorTextSecondary}"
                           FontSize="13"
                           Margin="8,0,0,0" />
                <ComboBox SelectedItem="{Binding SortMode}"
                          Width="130"
                          Background="{StaticResource ColorSurface}"
                          Foreground="{StaticResource ColorTextPrimary}"
                          BorderBrush="{StaticResource ColorBorder}">
                    <ComboBox.Items>
                        <vm:HabitSortMode>Priority</vm:HabitSortMode>
                        <vm:HabitSortMode>Tag</vm:HabitSortMode>
                    </ComboBox.Items>
                </ComboBox>
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="primary"
                    Content="⋮"
                    Width="36"
                    Height="36"
                    Padding="0"
                    FontSize="18"
                    CornerRadius="8"
                    Background="{StaticResource ColorSurface}"
                    Foreground="{StaticResource ColorTextPrimary}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="4" MinWidth="160">
                            <Button Content="+ New Habit"
                                    Command="{Binding OpenCreateHabitCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" />
                            <Button Content="+ New Column"
                                    Command="{Binding OpenCreateColumnCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Quadro Kanban (N Colunas) -->
        <Grid Grid.Row="1">

            <!-- Até 4 colunas: estica pra preencher a largura disponível -->
            <ItemsControl ItemsSource="{Binding KanbanColumns}"
                          ItemTemplate="{StaticResource KanbanColumnItemTemplate}"
                          IsVisible="{Binding KanbanColumns.Count, Converter={StaticResource CountAtMostConverter}, ConverterParameter=4}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Margin="0" HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Mais de 4 colunas: largura fixa por coluna + rolagem horizontal -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          IsVisible="{Binding KanbanColumns.Count, Converter={StaticResource CountAboveConverter}, ConverterParameter=4}">
                <ItemsControl ItemsSource="{Binding KanbanColumns}"
                              ItemTemplate="{StaticResource KanbanColumnItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- Esse selector alcança o Border.ColumnContainer dentro do
                         KanbanColumnView normalmente: estilos aplicados a um
                         ItemsControl cascateiam pela árvore visual mesmo
                         atravessando fronteiras de UserControl. -->
                    <ItemsControl.Styles>
                        <Style Selector="Border.ColumnContainer">
                            <Setter Property="Width" Value="280" />
                        </Style>
                    </ItemsControl.Styles>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
